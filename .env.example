# ---------------------------------------------------------------------------
# Contact form endpoint (optional but recommended)
# ---------------------------------------------------------------------------
# Any service that accepts a JSON POST and returns 2xx works. Examples:
#   Formspree : https://formspree.io/f/xxxxxxxx
#   Web3Forms : https://api.web3forms.com/submit   (also set PUBLIC_CONTACT_ACCESS_KEY)
#   Your own  : https://api.your-domain.com/contact
#
# When this is NOT set, the form still works: it validates, then hands the
# composed message to the visitor's mail client and offers copy-to-clipboard.
PUBLIC_CONTACT_ENDPOINT=

# Only needed by providers that require an access key in the payload
# (Web3Forms calls it `access_key`).
PUBLIC_CONTACT_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Deployment
