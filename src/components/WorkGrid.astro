---
import { allProjects, industryFacets } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const facets = industryFacets();
---

<div class="work-grid">
  <div class="work-grid__controls">
    <h2 class="visually-hidden" id="filter-heading">Filter projects by industry</h2>
    <div class="cluster" role="group" aria-labelledby="filter-heading">
      {
        facets.map((facet, i) => (
          <button
            type="button"
            class="chip"
            data-filter={facet.value}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {facet.value}
            <span class="chip__count" aria-hidden="true">{facet.count}</span>
            <span class="visually-hidden">({facet.count} projects)</span>
          </button>
        ))
      }
    </div>
    <p class="work-grid__status mono-meta" role="status" aria-live="polite" id="filter-status">
      Showing all {allProjects.length} projects
    </p>
  </div>

  <div class="work-grid__items" id="work-items">
    {allProjects.map((project, i) => <ProjectCard project={project} index={i} />)}
  </div>

  <div class="empty-state" id="work-empty" hidden>
    <svg class="empty-state__mark" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="m16.5 16.5 4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <p class="empty-state__title">No projects in that industry yet</p>
    <p>Clear the filter to see everything, or get in touch about work in this space.</p>
    <button type="button" class="btn btn--secondary btn--sm" id="work-clear">Show all projects</button>
  </div>
</div>

<style>
  .work-grid__controls {
    display: grid;
    gap: var(--space-3);
    margin-block-end: var(--space-7);
    padding-block-end: var(--space-5);
    border-block-end: var(--border-width) solid var(--hairline);
  }

  .work-grid__status {
    color: var(--ink-subtle);
  }

  .work-grid__items {
    display: grid;
    gap: var(--grid-gap);
  }

  @media (min-width: 44em) {
    .work-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72em) {
    .work-grid__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .empty-state__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--ink);
  }
</style>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const container = document.getElementById('work-items');
  const empty = document.getElementById('work-empty');
  const status = document.getElementById('filter-status');
  const clear = document.getElementById('work-clear');

  if (chips.length && container && empty && status) {
    const cards = Array.from(container.querySelectorAll<HTMLElement>('[data-industry]'));

    const apply = (value: string) => {
      let visible = 0;

      for (const card of cards) {
        const match = value === 'All' || card.dataset.industry === value;
        card.hidden = !match;
        if (match) visible += 1;
      }

      chips.forEach((chip) =>
        chip.setAttribute('aria-pressed', String(chip.dataset.filter === value)),
      );

      empty.hidden = visible > 0;
      container.hidden = visible === 0;

      status.textContent =
        visible === 0
          ? `No projects in ${value}`
          : value === 'All'
            ? `Showing all ${visible} projects`
            : `Showing ${visible} ${value} project${visible === 1 ? '' : 's'}`;

      // Reflect the filter in the URL so a filtered view can be shared.
      const url = new URL(window.location.href);
      if (value === 'All') url.searchParams.delete('industry');
      else url.searchParams.set('industry', value);
      window.history.replaceState({}, '', url);
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => apply(chip.dataset.filter ?? 'All'));
    });

    clear?.addEventListener('click', () => {
      apply('All');
      chips[0]?.focus();
    });

    // Honour ?industry= on load, so shared links land filtered.
    const initial = new URL(window.location.href).searchParams.get('industry');
    if (initial && chips.some((c) => c.dataset.filter === initial)) apply(initial);
  }
</script>
