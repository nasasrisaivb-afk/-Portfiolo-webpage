---
import { certifications, coreSkills, education, experience, resumeMeta } from '../data/resume';
import { asset, href } from '../lib/url';
import SectionHeader from './SectionHeader.astro';

interface Props {
  /** `full` renders the complete resume; `summary` is the home-page block. */
  variant?: 'summary' | 'full';
}

const { variant = 'summary' } = Astro.props;
// The full resume page owns the document's h1; the home-page block does not.
const headingLevel = variant === 'full' ? 'h1' : 'h2';
// Section headings sit one level below the block's own title, so the outline
// stays contiguous whether this renders as a page or as a home-page section.
const Sub = variant === 'full' ? 'h2' : 'h3';
const SubSub = variant === 'full' ? 'h3' : 'h4';
const pdf = asset(resumeMeta.file);
---

<div class="resume">
  <SectionHeader
    eyebrow="Resume"
    title={variant === 'full' ? `${resumeMeta.name} — resume` : 'Experience, education and credentials'}
    as={headingLevel}
    lead={`Updated ${resumeMeta.updated}. Read it here, or take the PDF.`}
  >
    <div class="resume__actions">
      <a class="btn btn--primary" href={pdf} download={resumeMeta.fileName}>
        <svg class="btn__icon" viewBox="0 0 16 16" aria-hidden="true">
          <path
            d="M8 2v8m0 0 3.2-3.2M8 10 4.8 6.8M2.5 12.5h11"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        Download resume (PDF)
      </a>
      <a class="btn btn--secondary" href={pdf} target="_blank" rel="noopener noreferrer">
        View resume
        <span class="visually-hidden">(opens the PDF in a new tab)</span>
      </a>
      {
        variant === 'summary' && (
          <a class="btn btn--ghost" href={href('/resume')}>
            Read it on this site
          </a>
        )
      }
    </div>
  </SectionHeader>

  <div class="resume__grid">
    <section class="resume__col js-reveal" aria-labelledby="resume-experience">
      <Sub class="resume__heading" id="resume-experience">Experience</Sub>
      <ol class="resume__list" role="list">
        {
          experience.map((item) => (
            <li class="resume__entry">
              <p class="mono-meta">{item.period}</p>
              <SubSub class="resume__entry-title">
                {item.role}
                <span>{item.organisation}</span>
              </SubSub>
              <p class="resume__entry-summary">{item.summary}</p>
              {variant === 'full' && (
                <ul class="resume__bullets" role="list">
                  {item.highlights.map((h) => <li>{h}</li>)}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <div class="resume__side">
      <section class="resume__col js-reveal" aria-labelledby="resume-education">
        <Sub class="resume__heading" id="resume-education">Education</Sub>
        <ul class="resume__list" role="list">
          {
            education.map((item) => (
              <li class="resume__entry">
                <p class="mono-meta">{item.period}</p>
                <SubSub class="resume__entry-title">
                  {item.qualification}
                  <span>{item.institution}</span>
                </SubSub>
                {item.detail && <p class="resume__entry-summary">{item.detail}</p>}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="resume__col js-reveal" aria-labelledby="resume-certs">
        <Sub class="resume__heading" id="resume-certs">Certifications</Sub>
        {
          certifications.length ? (
            <ul class="resume__list" role="list">
              {certifications.map((cert) => (
                <li class="resume__entry">
                  <p class="mono-meta">{cert.year}</p>
                  <SubSub class="resume__entry-title">
                    {cert.name}
                    <span>{cert.issuer}</span>
                  </SubSub>
                  {cert.credentialUrl && (
                    <a class="link" href={cert.credentialUrl} target="_blank" rel="noopener noreferrer">
                      View credential
                    </a>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="resume__entry-summary">No certifications listed yet.</p>
          )
        }
      </section>

      <section class="resume__col js-reveal" aria-labelledby="resume-skills">
        <Sub class="resume__heading" id="resume-skills">Core skills</Sub>
        <ul class="cluster resume__skills" role="list">
          {coreSkills.map((skill) => (
            <li><span class="tag">{skill}</span></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</div>

<style>
  .resume__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .resume__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 60em) {
    .resume__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4.5rem);
    }
  }

  .resume__side {
    display: grid;
    gap: var(--space-7);
    align-content: start;
  }

  .resume__heading {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-subtle);
    padding-block-end: var(--space-3);
    border-block-end: var(--border-width) solid var(--hairline);
  }

  .resume__list {
    display: grid;
    gap: var(--space-6);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .resume__entry {
    display: grid;
    gap: var(--space-2);
  }

  .resume__entry-title {
    display: grid;
    gap: 2px;
    font-size: var(--step-1);
    letter-spacing: var(--tracking-snug);
  }

  .resume__entry-title span {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--accent);
  }

  .resume__entry-summary {
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .resume__bullets {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: 66ch;
  }

  .resume__bullets li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
  }

  .resume__bullets li::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    margin-block-start: 0.55em;
    border-radius: 50%;
    background-color: var(--accent-line);
  }

  .resume__skills {
    --cluster-gap: var(--space-2);
    margin-block-start: var(--space-5);
  }
</style>
