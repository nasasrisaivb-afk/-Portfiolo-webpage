---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** Heading level, so the document outline stays correct in every context. */
  as?: 'h1' | 'h2' | 'h3';
  id?: string;
}

const { eyebrow, title, lead, as: Tag = 'h2', id } = Astro.props;
---

<div class="section-head js-reveal">
  <div class="section-head__title">
    <p class="eyebrow">{eyebrow}</p>
    <Tag id={id}>{title}</Tag>
  </div>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
