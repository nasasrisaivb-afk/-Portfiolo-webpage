---
/**
 * Self-hosted variable fonts, declared here rather than in a stylesheet so the
 * URLs pick up the deployment `base` (GitHub Pages serves from a sub-path).
 * Latin subset only: two files, ~84 KB total, zero third-party requests.
 */
import { asset } from '../lib/url';

const fraunces = asset('/fonts/fraunces-latin-wght-normal.woff2');
const inter = asset('/fonts/inter-latin-wght-normal.woff2');
---

<link rel="preload" href={inter} as="font" type="font/woff2" crossorigin="anonymous" />
<link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin="anonymous" />

<style is:inline set:html={`
@font-face {
  font-family: 'Inter Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${inter}') format('woff2-variations');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
    U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
    U+FEFF, U+FFFD;
}
@font-face {
  font-family: 'Fraunces Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${fraunces}') format('woff2-variations');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
    U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
    U+FEFF, U+FFFD;
}
`} />
