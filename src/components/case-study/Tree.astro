---
import type { NodeItem } from '../../data/types';

interface Props {
  items: NodeItem[];
  level?: number;
}

const { items, level = 0 } = Astro.props;
---

<ul class={`ia-tree ia-tree--${level}`} role="list">
  {
    items.map((item) => (
      <li class="ia-tree__item">
        <span class="ia-tree__label">{item.label}</span>
        {item.children?.length ? <Astro.self items={item.children} level={level + 1} /> : null}
      </li>
    ))
  }
</ul>

<style>
  .ia-tree {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ia-tree--0 {
    gap: var(--space-3);
  }

  .ia-tree--1,
  .ia-tree--2 {
    margin-block-start: var(--space-2);
    margin-inline-start: var(--space-4);
    padding-inline-start: var(--space-4);
    border-inline-start: var(--border-width) solid var(--border);
  }

  .ia-tree__label {
    display: inline-block;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .ia-tree--0 > .ia-tree__item > .ia-tree__label {
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
    color: var(--ink);
  }
</style>
