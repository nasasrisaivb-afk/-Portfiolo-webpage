---
import { footerLinks, profile } from '../data/site';
import { href } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell shell--wide">
    <div class="site-footer__top">
      <div class="site-footer__pitch">
        <p class="eyebrow eyebrow--plain">Available for work</p>
        <p class="site-footer__statement serif">
          Got a complex problem that needs to become a simple product?
        </p>
        <a class="btn btn--primary" href={href('/#contact')}>
          Start a conversation
          <svg class="btn__icon btn__icon--shift" viewBox="0 0 16 16" aria-hidden="true">
            <path
              d="M2 8h11M9 4l4 4-4 4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="site-footer__nav">
        {
          footerLinks.map((group) => (
            <div class="site-footer__group">
              <h2 class="site-footer__heading">{group.heading}</h2>
              <ul role="list">
                {group.links.map((link) => {
                  const external = /^https?:/.test(link.href);
                  return (
                    <li>
                      <a
                        href={external ? link.href : href(link.href)}
                        {...(external
                          ? { target: '_blank', rel: 'me noopener noreferrer' }
                          : {})}
                      >
                        {link.label}
                        {external && (
                          <svg class="site-footer__ext" viewBox="0 0 12 12" aria-hidden="true">
                            <path
                              d="M4 2h6v6M10 2 3 9"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.4"
                              stroke-linecap="round"
                              stroke-linejoin="round"></path>
                          </svg>
                        )}
                        {external && <span class="visually-hidden">(opens in a new tab)</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <hr class="rule" />

    <div class="site-footer__bottom">
      <p class="mono-meta">© {year} {profile.name}. All rights reserved.</p>
      <p class="mono-meta">
        {profile.location} · {profile.timezone}
      </p>
      <p class="mono-meta">
        Built with Astro · Designed and coded from scratch · WCAG 2.1 AA targeted
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-section-tight) var(--space-7);
    background-color: var(--canvas-contrast);
    border-block-start: var(--border-width) solid var(--hairline);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-9);
    padding-block-end: var(--space-8);
  }

  @media (min-width: 52em) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-8);
    }
  }

  .site-footer__pitch {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    align-content: start;
  }

  .site-footer__statement {
    font-size: var(--step-3);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    max-width: 22ch;
    text-wrap: balance;
  }

  .site-footer__nav {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 34em) {
    .site-footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .site-footer__group ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .site-footer__heading {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-subtle);
  }

  .site-footer__group a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-muted);
    text-decoration: none;
    padding-block: var(--space-1);
    overflow-wrap: anywhere;
  }

  .site-footer__group a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .site-footer__ext {
    inline-size: 0.7em;
    block-size: 0.7em;
    flex: none;
    opacity: 0.6;
  }

  .site-footer__bottom {
    display: grid;
    gap: var(--space-2);
    padding-block-start: var(--space-6);
  }

  @media (min-width: 60em) {
    .site-footer__bottom {
      grid-template-columns: auto auto 1fr;
      gap: var(--space-7);
      align-items: center;
    }

    .site-footer__bottom p:last-child {
      text-align: end;
    }
  }
</style>
